# macro variant r: blocks of the standard (generated by tools/build/gen_runtime.py), then the hearth and stela interactions
$function last_ember:bonfire/gen/build_$(variant)_r$(r)
kill @e[type=minecraft:interaction,tag=le.bonfire,distance=..5.5]
summon minecraft:interaction ~ ~ ~ {width:1.05f,height:1.0f,response:1b,Tags:["le.bonfire","le.hearth","le.new"]}
$summon minecraft:interaction ~ ~ ~-$(r) {width:1.05f,height:3.0f,response:1b,Tags:["le.bonfire","le.stela","le.new"]}
execute as @e[type=minecraft:interaction,tag=le.new,distance=..6] run scoreboard players operation @s le.bidx = #i le.e
tag @e[type=minecraft:interaction,tag=le.new,distance=..6] remove le.new
