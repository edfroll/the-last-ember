# generated by tools/build/r1_maze.py (maze_dp.py): 1 when somebody / something is in cell 1 or within 2 blocks of it: a player (not spectator), an ash trail, an item, a trader or an npc
execute if entity @a[x=-188,y=109,z=-468,dx=27,dy=12,dz=27,gamemode=!spectator] run return 1
execute if entity @e[type=minecraft:interaction,tag=le.ashclick,x=-188,y=109,z=-468,dx=27,dy=12,dz=27] run return 1
execute if entity @e[type=minecraft:item,x=-188,y=109,z=-468,dx=27,dy=12,dz=27] run return 1
execute if entity @e[tag=le.npc,x=-188,y=109,z=-468,dx=27,dy=12,dz=27] run return 1
execute if entity @e[tag=le.trader,x=-188,y=109,z=-468,dx=27,dy=12,dz=27] run return 1
return 0
