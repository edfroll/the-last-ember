# as a player: the Ember of the current gen with the lore of the chapters done
execute if score #chapters le.alt matches 0 run function last_ember:ember/gen/give_0 with storage last_ember:ember
execute if score #chapters le.alt matches 1 run function last_ember:ember/gen/give_1 with storage last_ember:ember
execute if score #chapters le.alt matches 2 run function last_ember:ember/gen/give_2 with storage last_ember:ember
execute if score #chapters le.alt matches 3 run function last_ember:ember/gen/give_3 with storage last_ember:ember
execute if score #chapters le.alt matches 4 run function last_ember:ember/gen/give_4 with storage last_ember:ember
execute if score #chapters le.alt matches 5 run function last_ember:ember/gen/give_5 with storage last_ember:ember
execute if score #chapters le.alt matches 6.. run function last_ember:ember/gen/give_6 with storage last_ember:ember
