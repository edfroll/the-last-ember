# generated by tools/build/r1_heather.py (heather_dp.py): every 2 s with a player within 64 of the hub: the next step of the sails (the sails stand when nobody is near)
execute unless entity @a[x=105.50,y=87.50,z=-469.95,distance=..64] run return 0
scoreboard players add #ms le.hv 1
execute if score #ms le.hv matches 8.. run scoreboard players set #ms le.hv 0
execute if score #ms le.hv matches 0 run function last_ember:heather/gen/mill_0
execute if score #ms le.hv matches 1 run function last_ember:heather/gen/mill_1
execute if score #ms le.hv matches 2 run function last_ember:heather/gen/mill_2
execute if score #ms le.hv matches 3 run function last_ember:heather/gen/mill_3
execute if score #ms le.hv matches 4 run function last_ember:heather/gen/mill_4
execute if score #ms le.hv matches 5 run function last_ember:heather/gen/mill_5
execute if score #ms le.hv matches 6 run function last_ember:heather/gen/mill_6
execute if score #ms le.hv matches 7 run function last_ember:heather/gen/mill_7
