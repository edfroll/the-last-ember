# as a player: applies the modifiers of the race by tag
execute if entity @s[tag=le.race.human] run function last_ember:char/gen/race_apply_1
execute if entity @s[tag=le.race.elf] run function last_ember:char/gen/race_apply_2
execute if entity @s[tag=le.race.dwarf] run function last_ember:char/gen/race_apply_3
execute if entity @s[tag=le.race.halfling] run function last_ember:char/gen/race_apply_4
execute if entity @s[tag=le.race.ashborn] run function last_ember:char/gen/race_apply_5
