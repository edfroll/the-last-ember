# as a player: applies the modifiers of the class by tag
execute if entity @s[tag=le.class.knight] run function last_ember:char/gen/class_apply_1
execute if entity @s[tag=le.class.ranger] run function last_ember:char/gen/class_apply_2
execute if entity @s[tag=le.class.seer] run function last_ember:char/gen/class_apply_3
execute if entity @s[tag=le.class.healer] run function last_ember:char/gen/class_apply_4
