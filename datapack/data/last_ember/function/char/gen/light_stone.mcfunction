# as a player: the stone of his people on the bottom of the Font lights up
execute if entity @s[tag=le.race.human] run setblock -3 52 54 minecraft:sea_lantern
execute if entity @s[tag=le.race.elf] run setblock 3 52 54 minecraft:sea_lantern
execute if entity @s[tag=le.race.dwarf] run setblock -3 52 60 minecraft:sea_lantern
execute if entity @s[tag=le.race.halfling] run setblock 3 52 60 minecraft:sea_lantern
execute if entity @s[tag=le.race.ashborn] run setblock 0 52 62 minecraft:sea_lantern
