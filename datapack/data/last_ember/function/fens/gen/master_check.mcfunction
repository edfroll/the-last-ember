# generated by tools/build/r1_fens.py (fens_dp.py): every 5 ticks: the Master of the Causeway (0 in the dark gap / 1 risen / 2 killed (skull) / 3 away until #mt)
execute if score #ms le.fn matches 3 if score #gt le.fn >= #mt le.fn run scoreboard players set #ms le.fn 0
execute if score #ms le.fn matches 0 positioned -359.5 135 323.5 if entity @a[distance=..6,gamemode=!spectator,gamemode=!creative] run return run function last_ember:fens/master_rise
execute if score #ms le.fn matches 0 positioned -359.5 134 323.5 as @a[distance=..10,gamemode=!spectator,gamemode=!creative] at @s if block ~ ~ ~ minecraft:water run return run function last_ember:fens/master_rise
execute if score #ms le.fn matches 1 run function last_ember:fens/master_tick
